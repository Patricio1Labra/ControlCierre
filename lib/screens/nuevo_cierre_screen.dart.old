import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:intl/intl.dart';
import '../models/cierre_caja.dart';
import '../services/database_service.dart';

class NuevoCierreScreen extends StatefulWidget {
  const NuevoCierreScreen({super.key});

  @override
  State<NuevoCierreScreen> createState() => _NuevoCierreScreenState();
}

class _NuevoCierreScreenState extends State<NuevoCierreScreen> {
  final _formKey = GlobalKey<FormState>();
  final DatabaseService _dbService = DatabaseService();

  // Controladores
  final TextEditingController _cajeroController = TextEditingController();
  final TextEditingController _efectivoInicialController =
      TextEditingController();
  final TextEditingController _ventasEfectivoController =
      TextEditingController();
  final TextEditingController _ventasTarjetaController =
      TextEditingController();
  final TextEditingController _ventasTransferenciaController =
      TextEditingController();
  final TextEditingController _gastosController = TextEditingController();
  final TextEditingController _retirosController = TextEditingController();
  final TextEditingController _efectivoFinalController =
      TextEditingController();
  final TextEditingController _observacionesController =
      TextEditingController();

  DateTime _fechaSeleccionada = DateTime.now();
  double _diferencia = 0.0;
  bool _isGuardando = false;

  @override
  void dispose() {
    _cajeroController.dispose();
    _efectivoInicialController.dispose();
    _ventasEfectivoController.dispose();
    _ventasTarjetaController.dispose();
    _ventasTransferenciaController.dispose();
    _gastosController.dispose();
    _retirosController.dispose();
    _efectivoFinalController.dispose();
    _observacionesController.dispose();
    super.dispose();
  }

  double _getDoubleValue(TextEditingController controller) {
    return double.tryParse(controller.text) ?? 0.0;
  }

  void _calcularDiferencia() {
    final efectivoInicial = _getDoubleValue(_efectivoInicialController);
    final ventasEfectivo = _getDoubleValue(_ventasEfectivoController);
    final gastos = _getDoubleValue(_gastosController);
    final retiros = _getDoubleValue(_retirosController);
    final efectivoFinal = _getDoubleValue(_efectivoFinalController);

    final efectivoEsperado =
        efectivoInicial + ventasEfectivo - gastos - retiros;
    setState(() {
      _diferencia = efectivoFinal - efectivoEsperado;
    });
  }

  Future<void> _seleccionarFecha() async {
    final DateTime? picked = await showDatePicker(
      context: context,
      initialDate: _fechaSeleccionada,
      firstDate: DateTime(2020),
      lastDate: DateTime.now(),
      locale: const Locale('es', 'ES'),
    );

    if (picked != null && picked != _fechaSeleccionada) {
      setState(() => _fechaSeleccionada = picked);
    }
  }

  Future<void> _guardarCierre() async {
    if (!_formKey.currentState!.validate()) {
      return;
    }

    setState(() => _isGuardando = true);

    try {
      final cierre = CierreCaja(
        fecha: _fechaSeleccionada,
        cajero: _cajeroController.text.trim(),
        efectivoInicial: _getDoubleValue(_efectivoInicialController),
        ventasEfectivo: _getDoubleValue(_ventasEfectivoController),
        ventasTarjeta: _getDoubleValue(_ventasTarjetaController),
        ventasTransferencia: _getDoubleValue(_ventasTransferenciaController),
        gastos: _getDoubleValue(_gastosController),
        retiros: _getDoubleValue(_retirosController),
        efectivoFinal: _getDoubleValue(_efectivoFinalController),
        diferencia: _diferencia,
        observaciones: _observacionesController.text.trim().isEmpty
            ? null
            : _observacionesController.text.trim(),
      );

      await _dbService.insertarCierre(cierre);

      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('Cierre guardado exitosamente'),
            backgroundColor: Colors.green,
          ),
        );
        Navigator.pop(context, true);
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Error al guardar: $e'),
            backgroundColor: Colors.red,
          ),
        );
      }
    } finally {
      setState(() => _isGuardando = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Nuevo Cierre de Caja'),
      ),
      body: Form(
        key: _formKey,
        child: ListView(
          padding: const EdgeInsets.all(16),
          children: [
            _buildSeccionInfo(),
            const SizedBox(height: 24),
            _buildSeccionVentas(),
            const SizedBox(height: 24),
            _buildSeccionEfectivo(),
            const SizedBox(height: 24),
            _buildSeccionResumen(),
            const SizedBox(height: 16),
            _buildSeccionObservaciones(),
            const SizedBox(height: 24),
            _buildBotonGuardar(),
            const SizedBox(height: 80),
          ],
        ),
      ),
    );
  }

  Widget _buildSeccionInfo() {
    return Card(
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text(
              'Información General',
              style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
            ),
            const SizedBox(height: 16),
            TextFormField(
              controller: _cajeroController,
              decoration: const InputDecoration(
                labelText: 'Nombre del Cajero',
                prefixIcon: Icon(Icons.person),
                border: OutlineInputBorder(),
              ),
              validator: (value) {
                if (value == null || value.trim().isEmpty) {
                  return 'Ingrese el nombre del cajero';
                }
                return null;
              },
            ),
            const SizedBox(height: 16),
            InkWell(
              onTap: _seleccionarFecha,
              child: InputDecorator(
                decoration: const InputDecoration(
                  labelText: 'Fecha del Cierre',
                  prefixIcon: Icon(Icons.calendar_today),
                  border: OutlineInputBorder(),
                ),
                child: Text(
                  DateFormat('dd/MM/yyyy').format(_fechaSeleccionada),
                  style: const TextStyle(fontSize: 16),
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildSeccionVentas() {
    return Card(
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text(
              'Ventas del Día',
              style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
            ),
            const SizedBox(height: 16),
            _buildCampoMoneda(
              controller: _ventasEfectivoController,
              label: 'Ventas en Efectivo',
              icon: Icons.attach_money,
              onChanged: _calcularDiferencia,
            ),
            const SizedBox(height: 12),
            _buildCampoMoneda(
              controller: _ventasTarjetaController,
              label: 'Ventas con Tarjeta',
              icon: Icons.credit_card,
            ),
            const SizedBox(height: 12),
            _buildCampoMoneda(
              controller: _ventasTransferenciaController,
              label: 'Ventas por Transferencia',
              icon: Icons.account_balance,
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildSeccionEfectivo() {
    return Card(
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text(
              'Movimiento de Efectivo',
              style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
            ),
            const SizedBox(height: 16),
            _buildCampoMoneda(
              controller: _efectivoInicialController,
              label: 'Efectivo Inicial',
              icon: Icons.wallet,
              onChanged: _calcularDiferencia,
            ),
            const SizedBox(height: 12),
            _buildCampoMoneda(
              controller: _gastosController,
              label: 'Gastos',
              icon: Icons.shopping_basket,
              onChanged: _calcularDiferencia,
            ),
            const SizedBox(height: 12),
            _buildCampoMoneda(
              controller: _retirosController,
              label: 'Retiros',
              icon: Icons.remove_circle,
              onChanged: _calcularDiferencia,
            ),
            const SizedBox(height: 12),
            _buildCampoMoneda(
              controller: _efectivoFinalController,
              label: 'Efectivo Final Contado',
              icon: Icons.payments,
              onChanged: _calcularDiferencia,
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildSeccionResumen() {
    final efectivoEsperado = _getDoubleValue(_efectivoInicialController) +
        _getDoubleValue(_ventasEfectivoController) -
        _getDoubleValue(_gastosController) -
        _getDoubleValue(_retirosController);

    final totalVentas = _getDoubleValue(_ventasEfectivoController) +
        _getDoubleValue(_ventasTarjetaController) +
        _getDoubleValue(_ventasTransferenciaController);

    final bool hayDiferencia = _diferencia.abs() > 0.01;
    final bool esFaltante = _diferencia < 0;

    return Card(
      color: hayDiferencia
          ? (esFaltante ? Colors.red[50] : Colors.green[50])
          : Colors.blue[50],
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text(
              'Resumen',
              style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
            ),
            const SizedBox(height: 16),
            _buildResumenItem(
              'Total Ventas',
              totalVentas,
              Colors.blue,
            ),
            const Divider(),
            _buildResumenItem(
              'Efectivo Esperado',
              efectivoEsperado,
              Colors.orange,
            ),
            const Divider(),
            _buildResumenItem(
              hayDiferencia
                  ? (esFaltante ? 'FALTANTE' : 'SOBRANTE')
                  : 'CIERRE CUADRADO',
              _diferencia.abs(),
              hayDiferencia
                  ? (esFaltante ? Colors.red : Colors.green)
                  : Colors.blue,
              isDestacado: true,
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildResumenItem(
    String label,
    double valor,
    Color color, {
    bool isDestacado = false,
  }) {
    final NumberFormat currencyFormat =
        NumberFormat.currency(symbol: '\$', decimalDigits: 2);

    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 8),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Text(
            label,
            style: TextStyle(
              fontSize: isDestacado ? 18 : 16,
              fontWeight: isDestacado ? FontWeight.bold : FontWeight.normal,
              color: color,
            ),
          ),
          Text(
            currencyFormat.format(valor),
            style: TextStyle(
              fontSize: isDestacado ? 20 : 16,
              fontWeight: FontWeight.bold,
              color: color,
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildSeccionObservaciones() {
    return Card(
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text(
              'Observaciones',
              style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
            ),
            const SizedBox(height: 16),
            TextFormField(
              controller: _observacionesController,
              decoration: const InputDecoration(
                hintText: 'Notas adicionales (opcional)',
                border: OutlineInputBorder(),
              ),
              maxLines: 3,
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildCampoMoneda({
    required TextEditingController controller,
    required String label,
    required IconData icon,
    VoidCallback? onChanged,
  }) {
    return TextFormField(
      controller: controller,
      decoration: InputDecoration(
        labelText: label,
        prefixIcon: Icon(icon),
        prefixText: '\$ ',
        border: const OutlineInputBorder(),
      ),
      keyboardType: const TextInputType.numberWithOptions(decimal: true),
      inputFormatters: [
        FilteringTextInputFormatter.allow(RegExp(r'^\d*\.?\d{0,2}')),
      ],
      onChanged: (value) {
        if (onChanged != null) onChanged();
      },
      validator: (value) {
        if (value == null || value.isEmpty) {
          return 'Ingrese un valor';
        }
        if (double.tryParse(value) == null) {
          return 'Valor inválido';
        }
        return null;
      },
    );
  }

  Widget _buildBotonGuardar() {
    return SizedBox(
      width: double.infinity,
      height: 50,
      child: ElevatedButton.icon(
        onPressed: _isGuardando ? null : _guardarCierre,
        icon: _isGuardando
            ? const SizedBox(
                width: 20,
                height: 20,
                child: CircularProgressIndicator(
                  strokeWidth: 2,
                  color: Colors.white,
                ),
              )
            : const Icon(Icons.save),
        label: Text(
          _isGuardando ? 'Guardando...' : 'Guardar Cierre',
          style: const TextStyle(fontSize: 16),
        ),
        style: ElevatedButton.styleFrom(
          backgroundColor: Colors.blue,
          foregroundColor: Colors.white,
        ),
      ),
    );
  }
}
