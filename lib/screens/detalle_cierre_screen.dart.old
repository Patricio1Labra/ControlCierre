import 'package:flutter/material.dart';
import 'package:intl/intl.dart';
import 'package:printing/printing.dart';
import '../models/cierre_caja.dart';
import '../services/pdf_service.dart';
import '../services/database_service.dart';

class DetalleCierreScreen extends StatelessWidget {
  final CierreCaja cierre;

  const DetalleCierreScreen({super.key, required this.cierre});

  @override
  Widget build(BuildContext context) {
    final DateFormat dateFormat = DateFormat('dd/MM/yyyy');
    final DateFormat timeFormat = DateFormat('HH:mm');
    final NumberFormat currencyFormat =
        NumberFormat.currency(symbol: '\$', decimalDigits: 2);

    final bool hayDiferencia = cierre.tieneDiferencia;
    final bool esFaltante = cierre.diferencia < 0;

    return Scaffold(
      appBar: AppBar(
        title: const Text('Detalle del Cierre'),
        actions: [
          IconButton(
            icon: const Icon(Icons.delete),
            onPressed: () => _confirmarEliminar(context),
            tooltip: 'Eliminar',
          ),
        ],
      ),
      body: ListView(
        padding: const EdgeInsets.all(16),
        children: [
          // Información general
          Card(
            child: Padding(
              padding: const EdgeInsets.all(16),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Row(
                    mainAxisAlignment: MainAxisAlignment.spaceBetween,
                    children: [
                      Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          const Text(
                            'Cajero',
                            style: TextStyle(
                              fontSize: 12,
                              color: Colors.grey,
                            ),
                          ),
                          Text(
                            cierre.cajero,
                            style: const TextStyle(
                              fontSize: 20,
                              fontWeight: FontWeight.bold,
                            ),
                          ),
                        ],
                      ),
                      Column(
                        crossAxisAlignment: CrossAxisAlignment.end,
                        children: [
                          const Text(
                            'Cierre N°',
                            style: TextStyle(
                              fontSize: 12,
                              color: Colors.grey,
                            ),
                          ),
                          Text(
                            '${cierre.id}',
                            style: const TextStyle(
                              fontSize: 20,
                              fontWeight: FontWeight.bold,
                            ),
                          ),
                        ],
                      ),
                    ],
                  ),
                  const SizedBox(height: 16),
                  Row(
                    mainAxisAlignment: MainAxisAlignment.spaceBetween,
                    children: [
                      Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          const Text(
                            'Fecha',
                            style: TextStyle(fontSize: 12, color: Colors.grey),
                          ),
                          Text(
                            dateFormat.format(cierre.fecha),
                            style: const TextStyle(fontSize: 16),
                          ),
                        ],
                      ),
                      Column(
                        crossAxisAlignment: CrossAxisAlignment.end,
                        children: [
                          const Text(
                            'Hora de registro',
                            style: TextStyle(fontSize: 12, color: Colors.grey),
                          ),
                          Text(
                            timeFormat.format(cierre.fechaCreacion),
                            style: const TextStyle(fontSize: 16),
                          ),
                        ],
                      ),
                    ],
                  ),
                ],
              ),
            ),
          ),
          const SizedBox(height: 16),

          // Ventas
          Card(
            child: Padding(
              padding: const EdgeInsets.all(16),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  const Text(
                    'Ventas del Día',
                    style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
                  ),
                  const SizedBox(height: 12),
                  _buildDetalleFila(
                      'Efectivo', currencyFormat.format(cierre.ventasEfectivo)),
                  _buildDetalleFila(
                      'Tarjeta', currencyFormat.format(cierre.ventasTarjeta)),
                  _buildDetalleFila('Transferencia',
                      currencyFormat.format(cierre.ventasTransferencia)),
                  const Divider(),
                  _buildDetalleFila(
                    'TOTAL',
                    currencyFormat.format(cierre.totalVentas),
                    isTotal: true,
                  ),
                ],
              ),
            ),
          ),
          const SizedBox(height: 16),

          // Movimiento de efectivo
          Card(
            child: Padding(
              padding: const EdgeInsets.all(16),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  const Text(
                    'Movimiento de Efectivo',
                    style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
                  ),
                  const SizedBox(height: 12),
                  _buildDetalleFila('Efectivo Inicial',
                      currencyFormat.format(cierre.efectivoInicial)),
                  _buildDetalleFila('+ Ventas en Efectivo',
                      currencyFormat.format(cierre.ventasEfectivo),
                      color: Colors.green),
                  _buildDetalleFila(
                      '- Gastos', currencyFormat.format(cierre.gastos),
                      color: Colors.red),
                  _buildDetalleFila(
                      '- Retiros', currencyFormat.format(cierre.retiros),
                      color: Colors.red),
                  const Divider(),
                  _buildDetalleFila(
                    '= Efectivo Esperado',
                    currencyFormat.format(cierre.efectivoEsperado),
                    isTotal: true,
                    color: Colors.orange,
                  ),
                  const SizedBox(height: 8),
                  _buildDetalleFila(
                    'Efectivo Real Contado',
                    currencyFormat.format(cierre.efectivoFinal),
                    isTotal: true,
                    color: Colors.blue,
                  ),
                ],
              ),
            ),
          ),
          const SizedBox(height: 16),

          // Diferencia
          Card(
            color: hayDiferencia
                ? (esFaltante ? Colors.red[50] : Colors.green[50])
                : Colors.blue[50],
            child: Padding(
              padding: const EdgeInsets.all(20),
              child: Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        hayDiferencia
                            ? (esFaltante ? 'FALTANTE' : 'SOBRANTE')
                            : 'CIERRE CUADRADO',
                        style: TextStyle(
                          fontSize: 18,
                          fontWeight: FontWeight.bold,
                          color: hayDiferencia
                              ? (esFaltante ? Colors.red[900] : Colors.green[900])
                              : Colors.blue[900],
                        ),
                      ),
                      if (hayDiferencia)
                        Text(
                          esFaltante
                              ? 'Falta dinero en caja'
                              : 'Sobra dinero en caja',
                          style: TextStyle(
                            fontSize: 12,
                            color: esFaltante ? Colors.red[700] : Colors.green[700],
                          ),
                        ),
                    ],
                  ),
                  Text(
                    currencyFormat.format(cierre.diferencia.abs()),
                    style: TextStyle(
                      fontSize: 28,
                      fontWeight: FontWeight.bold,
                      color: hayDiferencia
                          ? (esFaltante ? Colors.red[900] : Colors.green[900])
                          : Colors.blue[900],
                    ),
                  ),
                ],
              ),
            ),
          ),

          // Observaciones
          if (cierre.observaciones != null && cierre.observaciones!.isNotEmpty)
            Column(
              children: [
                const SizedBox(height: 16),
                Card(
                  child: Padding(
                    padding: const EdgeInsets.all(16),
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        const Text(
                          'Observaciones',
                          style: TextStyle(
                              fontSize: 18, fontWeight: FontWeight.bold),
                        ),
                        const SizedBox(height: 8),
                        Text(
                          cierre.observaciones!,
                          style: const TextStyle(fontSize: 14),
                        ),
                      ],
                    ),
                  ),
                ),
              ],
            ),

          const SizedBox(height: 24),

          // Botones de acción
          Row(
            children: [
              Expanded(
                child: ElevatedButton.icon(
                  onPressed: () => _verPdf(context),
                  icon: const Icon(Icons.picture_as_pdf),
                  label: const Text('Ver PDF'),
                  style: ElevatedButton.styleFrom(
                    padding: const EdgeInsets.symmetric(vertical: 16),
                  ),
                ),
              ),
              const SizedBox(width: 8),
              Expanded(
                child: ElevatedButton.icon(
                  onPressed: () => _compartirPdf(context),
                  icon: const Icon(Icons.share),
                  label: const Text('Compartir'),
                  style: ElevatedButton.styleFrom(
                    padding: const EdgeInsets.symmetric(vertical: 16),
                  ),
                ),
              ),
            ],
          ),
          const SizedBox(height: 8),
          SizedBox(
            width: double.infinity,
            child: ElevatedButton.icon(
              onPressed: () => _imprimirPdf(context),
              icon: const Icon(Icons.print),
              label: const Text('Imprimir'),
              style: ElevatedButton.styleFrom(
                padding: const EdgeInsets.symmetric(vertical: 16),
                backgroundColor: Colors.green,
                foregroundColor: Colors.white,
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildDetalleFila(
    String label,
    String valor, {
    bool isTotal = false,
    Color? color,
  }) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 6),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Text(
            label,
            style: TextStyle(
              fontSize: isTotal ? 16 : 14,
              fontWeight: isTotal ? FontWeight.bold : FontWeight.normal,
              color: color,
            ),
          ),
          Text(
            valor,
            style: TextStyle(
              fontSize: isTotal ? 16 : 14,
              fontWeight: FontWeight.bold,
              color: color,
            ),
          ),
        ],
      ),
    );
  }

  Future<void> _verPdf(BuildContext context) async {
    try {
      final pdf = await PdfService.generarPdfCierre(cierre);
      if (context.mounted) {
        await Navigator.push(
          context,
          MaterialPageRoute(
            builder: (context) => Scaffold(
              appBar: AppBar(
                title: const Text('Vista Previa PDF'),
              ),
              body: PdfPreview(
                build: (format) => pdf.save(),
                canChangeOrientation: false,
                canDebug: false,
              ),
            ),
          ),
        );
      }
    } catch (e) {
      if (context.mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Error al generar PDF: $e'),
            backgroundColor: Colors.red,
          ),
        );
      }
    }
  }

  Future<void> _compartirPdf(BuildContext context) async {
    try {
      final pdf = await PdfService.generarPdfCierre(cierre);
      final fileName =
          'cierre_${cierre.id}_${DateFormat('dd-MM-yyyy').format(cierre.fecha)}.pdf';
      await PdfService.compartirPdf(pdf, fileName);
    } catch (e) {
      if (context.mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Error al compartir PDF: $e'),
            backgroundColor: Colors.red,
          ),
        );
      }
    }
  }

  Future<void> _imprimirPdf(BuildContext context) async {
    try {
      final pdf = await PdfService.generarPdfCierre(cierre);
      await PdfService.imprimirPdf(pdf);
    } catch (e) {
      if (context.mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Error al imprimir: $e'),
            backgroundColor: Colors.red,
          ),
        );
      }
    }
  }

  Future<void> _confirmarEliminar(BuildContext context) async {
    final confirmar = await showDialog<bool>(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Confirmar eliminación'),
        content:
            const Text('¿Está seguro de que desea eliminar este cierre?'),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context, false),
            child: const Text('Cancelar'),
          ),
          TextButton(
            onPressed: () => Navigator.pop(context, true),
            style: TextButton.styleFrom(foregroundColor: Colors.red),
            child: const Text('Eliminar'),
          ),
        ],
      ),
    );

    if (confirmar == true && context.mounted) {
      try {
        await DatabaseService().eliminarCierre(cierre.id!);
        if (context.mounted) {
          ScaffoldMessenger.of(context).showSnackBar(
            const SnackBar(
              content: Text('Cierre eliminado'),
              backgroundColor: Colors.green,
            ),
          );
          Navigator.pop(context);
        }
      } catch (e) {
        if (context.mounted) {
          ScaffoldMessenger.of(context).showSnackBar(
            SnackBar(
              content: Text('Error al eliminar: $e'),
              backgroundColor: Colors.red,
            ),
          );
        }
      }
    }
  }
}
