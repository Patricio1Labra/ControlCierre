import 'package:sqflite/sqflite.dart';
import 'package:path/path.dart';
import '../models/cierre_caja.dart';

/// Servicio para manejo de base de datos SQLite local
class DatabaseService {
  static final DatabaseService _instance = DatabaseService._internal();
  static Database? _database;

  factory DatabaseService() => _instance;

  DatabaseService._internal();

  Future<Database> get database async {
    if (_database != null) return _database!;
    _database = await _initDatabase();
    return _database!;
  }

  Future<Database> _initDatabase() async {
    final databasePath = await getDatabasesPath();
    final path = join(databasePath, 'control_cierre.db');

    return await openDatabase(
      path,
      version: 1,
      onCreate: _onCreate,
    );
  }

  Future<void> _onCreate(Database db, int version) async {
    await db.execute('''
      CREATE TABLE cierres (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        fecha TEXT NOT NULL,
        cajero TEXT NOT NULL,
        efectivo_inicial REAL NOT NULL,
        ventas_efectivo REAL NOT NULL,
        ventas_tarjeta REAL NOT NULL,
        ventas_transferencia REAL NOT NULL,
        gastos REAL NOT NULL,
        retiros REAL NOT NULL,
        efectivo_final REAL NOT NULL,
        diferencia REAL NOT NULL,
        observaciones TEXT,
        fecha_creacion TEXT NOT NULL
      )
    ''');

    // Índices para mejorar búsquedas
    await db.execute('CREATE INDEX idx_fecha ON cierres(fecha)');
    await db.execute('CREATE INDEX idx_cajero ON cierres(cajero)');
  }

  // Insertar un nuevo cierre
  Future<int> insertarCierre(CierreCaja cierre) async {
    final db = await database;
    return await db.insert('cierres', cierre.toMap());
  }

  // Obtener todos los cierres (ordenados por fecha descendente)
  Future<List<CierreCaja>> obtenerCierres() async {
    final db = await database;
    final List<Map<String, dynamic>> maps = await db.query(
      'cierres',
      orderBy: 'fecha DESC',
    );

    return List.generate(maps.length, (i) => CierreCaja.fromMap(maps[i]));
  }

  // Obtener cierres por rango de fechas
  Future<List<CierreCaja>> obtenerCierresPorFechas(
    DateTime inicio,
    DateTime fin,
  ) async {
    final db = await database;
    final List<Map<String, dynamic>> maps = await db.query(
      'cierres',
      where: 'fecha BETWEEN ? AND ?',
      whereArgs: [inicio.toIso8601String(), fin.toIso8601String()],
      orderBy: 'fecha DESC',
    );

    return List.generate(maps.length, (i) => CierreCaja.fromMap(maps[i]));
  }

  // Obtener cierres por cajero
  Future<List<CierreCaja>> obtenerCierresPorCajero(String cajero) async {
    final db = await database;
    final List<Map<String, dynamic>> maps = await db.query(
      'cierres',
      where: 'cajero = ?',
      whereArgs: [cajero],
      orderBy: 'fecha DESC',
    );

    return List.generate(maps.length, (i) => CierreCaja.fromMap(maps[i]));
  }

  // Obtener un cierre por ID
  Future<CierreCaja?> obtenerCierre(int id) async {
    final db = await database;
    final List<Map<String, dynamic>> maps = await db.query(
      'cierres',
      where: 'id = ?',
      whereArgs: [id],
    );

    if (maps.isEmpty) return null;
    return CierreCaja.fromMap(maps.first);
  }

  // Actualizar un cierre
  Future<int> actualizarCierre(CierreCaja cierre) async {
    final db = await database;
    return await db.update(
      'cierres',
      cierre.toMap(),
      where: 'id = ?',
      whereArgs: [cierre.id],
    );
  }

  // Eliminar un cierre
  Future<int> eliminarCierre(int id) async {
    final db = await database;
    return await db.delete(
      'cierres',
      where: 'id = ?',
      whereArgs: [id],
    );
  }

  // Obtener lista de cajeros únicos
  Future<List<String>> obtenerCajeros() async {
    final db = await database;
    final List<Map<String, dynamic>> maps = await db.rawQuery(
      'SELECT DISTINCT cajero FROM cierres ORDER BY cajero',
    );

    return List.generate(maps.length, (i) => maps[i]['cajero'] as String);
  }

  // Estadísticas: total de ventas por período
  Future<Map<String, double>> obtenerEstadisticas(
    DateTime inicio,
    DateTime fin,
  ) async {
    final db = await database;
    final List<Map<String, dynamic>> result = await db.rawQuery('''
      SELECT
        SUM(ventas_efectivo) as total_efectivo,
        SUM(ventas_tarjeta) as total_tarjeta,
        SUM(ventas_transferencia) as total_transferencia,
        SUM(gastos) as total_gastos,
        SUM(diferencia) as total_diferencias,
        COUNT(*) as total_cierres
      FROM cierres
      WHERE fecha BETWEEN ? AND ?
    ''', [inicio.toIso8601String(), fin.toIso8601String()]);

    final data = result.first;
    return {
      'total_efectivo': (data['total_efectivo'] as num?)?.toDouble() ?? 0.0,
      'total_tarjeta': (data['total_tarjeta'] as num?)?.toDouble() ?? 0.0,
      'total_transferencia':
          (data['total_transferencia'] as num?)?.toDouble() ?? 0.0,
      'total_gastos': (data['total_gastos'] as num?)?.toDouble() ?? 0.0,
      'total_diferencias':
          (data['total_diferencias'] as num?)?.toDouble() ?? 0.0,
      'total_cierres': (data['total_cierres'] as num?)?.toDouble() ?? 0.0,
    };
  }

  // Cerrar la base de datos
  Future<void> close() async {
    final db = await database;
    await db.close();
  }
}
