{
  "$schema": "https://opencode.ai/config.json",

  "model": "qwen-local/qwen3-Q4_K_M-imatrix.gguf",

  "provider": {
    "qwen-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Qwen Local",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3-Q4_K_M-imatrix.gguf": {
          "name": "Qwen3 Q4_K_M imatrix",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },

  "mcp": {
    "dart": {
      "type": "local",
      "command": [
        "dart",
        "mcp-server"
      ],
      "enabled": true
    }
  }
}
